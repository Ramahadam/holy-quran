{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "holy-quran-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-21",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": ["QF_CLIENT_ID", "QF_CLIENT_SECRET"]
  },
  "ratelimits": [
    {
      "name": "TAFSIR_RATE_LIMITER",
      "namespace_id": "7901",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "FEEDBACK_RATE_LIMITER",
      "namespace_id": "7902",
      "simple": { "limit": 3, "period": 60 }
    },
    {
      "name": "FEEDBACK_NETWORK_RATE_LIMITER",
      "namespace_id": "7903",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "FEEDBACK_DB",
      "database_name": "holy-quran-feedback",
      "database_id": "14334942-d455-44e6-8494-be48e031b7b1",
      "migrations_dir": "migrations"
    }
  ]
}
